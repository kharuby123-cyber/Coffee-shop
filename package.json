{
  "name": "coffeeshop",
  "version": "1.0.0",
  "description": "CoffeeShop - Vietnamese Coffee Shop Dynamic Web App with TypeScript + SQLite",
  "main": "dist/server.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/server.js",
    "dev": "npx ts-node src/server.ts",
    "dev:watch": "nodemon --watch src --ext ts --exec \"npx ts-node src/server.ts\""
  },
  "keywords": ["coffeeshop", "coffee", "nodejs", "typescript", "sqlite", "express"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.29",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
